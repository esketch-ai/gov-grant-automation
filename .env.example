# =========================================================================
# SSHAI-CWA 환경변수 — .env 가 하드코딩 금지 원칙(최은정 보안 감사)
# 실제 값은 .env 에 적는다(커밋 금지). `cp .env.example .env` 후 수정.
# =========================================================================

# --- LLM (로컬 Ollama 1순위) ---
LLM_PROVIDER=ollama            # ollama(기본) | cloud
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:32b        # 경량: llama3.1:8b
# LLM 불필요/오프라인 스모크 테스트용 (1 이면 파싱/매칭은 degrade 폴백 사용)
LLM_OFFLINE=0

# --- 클라우드(선택, cloud 시에만) ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=

# --- 공공데이터 API (부재 시 해당 포털 수집은 WARN 후 건별 건너뜀) ---
DATA_GO_KR_KEY=
G2B_API_KEY=
TAVILLY_API_KEY=

# --- SMTP (Gmail 앱 비밀번호) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_account@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_SENDER_NAME=정부과제 AI 매칭 에이전트
